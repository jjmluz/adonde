// Copy this file to Secrets.xcconfig (git-ignored) and put the iOS Maps key in it.
// The key is restricted to iOS apps with the bundle id com.jjmluz.adonde; the Android key can't be used here.
MAPS_API_KEY = your-ios-key

// Only for running on a real iPhone: the team picked in Xcode's Signing & Capabilities (its ID, 10 characters).
DEVELOPMENT_TEAM = YOURTEAMID
